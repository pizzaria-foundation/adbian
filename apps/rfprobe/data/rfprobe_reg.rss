/* Application registration. Installed into \private\10003a3f\import\apps\ — that exact path
 * is what makes the app appear in the S60 menu. */

#include <appinfo.rh>
#include "rfprobe.rsg"

UID2 KUidAppRegistrationResourceFile
UID3 0xE0AA00F0

RESOURCE APP_REGISTRATION_INFO
    {
    app_file = "rfprobe";
    localisable_resource_file = "\\resource\\apps\\rfprobe";
    localisable_resource_id = R_RFPROBE_LOCALISABLE_APP_INFO;
    hidden = KAppNotHidden;
    embeddability = KAppNotEmbeddable;
    newfile = KAppDoesNotSupportNewFile;
    launch = KAppLaunchInForeground;
    }
